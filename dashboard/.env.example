# ---------------------------------------------------------------------------
# Personal dashboard — every variable is SERVER-SIDE ONLY.
# None of them start with NEXT_PUBLIC_, so none reach the browser.
# Copy to .env.local for local dev; add the same names in Vercel →
# Project → Settings → Environment Variables for production.
# ---------------------------------------------------------------------------

# The dashboard's own Supabase project (login + icons/cards/settings tables).
DASHBOARD_SUPABASE_URL=https://your-dashboard-project.supabase.co
DASHBOARD_SUPABASE_ANON_KEY=your-dashboard-anon-or-publishable-key

# Who may sign in. Comma separated, case-insensitive.
# Also add the same email to the dashboard_owners table (see README).
ALLOWED_EMAILS=you@example.com

# Public URL of the deployed site, used in the sign-in email link.
# Optional: when unset, the request's own host is used.
SITE_URL=https://your-dashboard.vercel.app

# ---------------------------------------------------------------------------
# One block per project that has report cards. The prefix must match the
# card's "project" value (RMI → RMI_SUPABASE_URL ...).
# Use either the ANON key (respects that project's RLS) or, for read access
# past RLS, the SERVICE_ROLE key — it is preferred when both are set.
# A project without these shows an error on its own cards only.
# ---------------------------------------------------------------------------
RMI_SUPABASE_URL=https://your-rmi-project.supabase.co
RMI_SUPABASE_ANON_KEY=
RMI_DASHBOARD_KEY=              # secret for the key-guarded RMI functions
# RMI_SUPABASE_SERVICE_ROLE_KEY=

# SS Family: its anon key alone can't read anything (all tables need a
# signed-in user), so its cards call key-guarded functions. Run the SS Family
# migration 20261018090000_home_dashboard_metrics.sql there, store the hash of
# a long random secret as that file explains, and put the secret here.
SS_FAMILY_SUPABASE_URL=https://your-ss-family-project.supabase.co
SS_FAMILY_SUPABASE_ANON_KEY=
SS_FAMILY_DASHBOARD_KEY=

# Any project's rpc cards get <PROJECT>_DASHBOARD_KEY as the p_key argument
# when that variable is set.

# MBL / SSA / VISTA cards are placeholders for now. Fill these in when you
# switch their cards to real queries.
MBL_SUPABASE_URL=
MBL_SUPABASE_ANON_KEY=
SSA_SUPABASE_URL=
SSA_SUPABASE_ANON_KEY=
VISTA_SUPABASE_URL=
VISTA_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Phase 2 (not used yet)
