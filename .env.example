# ---------------------------------------------------------------------------
# Copy this file to `.env` before running the app:
#     cp .env.example .env
#
# These are the live values for the "SS-FAMILY" Supabase project. The
# publishable key is safe to expose in a browser: every table is protected by
# row level security, so the key alone grants nothing without a signed-in user.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://fhhecuvtgukcfulynwje.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_8UhAXxC27Myr6DSjQSutxA_YENBv3sJ

# Optional. Default currency shown against menu costs.
VITE_CURRENCY=SAR

# ---------------------------------------------------------------------------
# The secrets below are NOT read by the frontend. They belong to the Supabase
# edge functions and must be set with the Supabase CLI or dashboard:
#
#   supabase secrets set GOOGLE_CLIENT_ID=...
#
# Everything works without them - Google Calendar falls back to a one-click
# "Add to Calendar" link plus an .ics download, and WhatsApp notifications
# stay in the in-app inbox.
#
#   GOOGLE_CLIENT_ID          OAuth2 client id
#   GOOGLE_CLIENT_SECRET      OAuth2 client secret
#   GOOGLE_REFRESH_TOKEN      refresh token for the family calendar account
#   GOOGLE_CALENDAR_ID        e.g. primary, or a shared calendar id
#
#   TWILIO_ACCOUNT_SID        Twilio account SID
#   TWILIO_AUTH_TOKEN         Twilio auth token
#   TWILIO_WHATSAPP_FROM      e.g. whatsapp:+14155238886
# ---------------------------------------------------------------------------
