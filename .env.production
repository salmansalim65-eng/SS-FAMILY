# Build-time configuration for production builds (Vercel and friends).
#
# Committed on purpose. A Supabase publishable key is designed to sit in a
# browser bundle - it identifies the project, it does not authorise anything.
# Every table is behind row level security and needs a signed-in user, so this
# key on its own grants no access to any data.
#
# Setting VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY in the Vercel
# project's environment variables overrides these values.
VITE_SUPABASE_URL=https://fhhecuvtgukcfulynwje.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_8UhAXxC27Myr6DSjQSutxA_YENBv3sJ
VITE_CURRENCY=SAR
